{
  "name": "dsh-codex-app-server",
  "version": "0.1.0-beta.0",
  "description": "DeepSeek Harness AgentFactory provider for the official Codex App Server",
  "keywords": [
    "deepseek-harness",
    "codex",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyleMi/dsh-codex-app-server.git"
  },
  "bugs": {
    "url": "https://github.com/LyleMi/dsh-codex-app-server/issues"
  },
  "homepage": "https://github.com/LyleMi/dsh-codex-app-server#readme",
  "type": "module",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/real-codex.e2e.ts",
    "test:coverage": "vitest run --coverage",
    "protocol:check": "node scripts/check-codex-protocol.mjs",
    "lint": "eslint .",
    "reforge": "reforge config validate . && node scripts/check-reforge.mjs",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm check",
    "check": "pnpm format:check && pnpm lint && pnpm reforge && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm pack:check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6",
    "@eslint/js": "^9.33.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.17.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "js-yaml": "^4.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
